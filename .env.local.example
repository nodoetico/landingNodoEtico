# ─────────────────────────────────────────────────────────────
# VARIABLES DE ENTORNO — NODO ÉTICO
# Copiar este archivo a `.env.local` y completar los valores.
# Las variables con el prefijo NEXT_PUBLIC_ son públicas y quedan
# expuestas en el bundle del navegador. Úsalas solo con datos no sensibles.
# ─────────────────────────────────────────────────────────────

## Datos públicos de la empresa
# Dominio del sitio. Se usa para SEO, Open Graph, sitemap y JSON-LD.
NEXT_PUBLIC_DOMINIO=https://nodoetico.com

# WhatsApp en formato internacional, SOLO dígitos (sin + ni espacios).
# Argentina: 54 + 9 + area + numero  ->  5493885788043
NEXT_PUBLIC_WHATSAPP_NUMERO=5493885788043

# Correo institucional de contacto.
NEXT_PUBLIC_EMAIL_CONTACTO=contacto@nodoetico.com

# Redes sociales (dejar vacío para ocultarlas del pie de página).
NEXT_PUBLIC_FACEBOOK=https://www.facebook.com/share/19oRSqcZLH/
NEXT_PUBLIC_INSTAGRAM=https://www.instagram.com/buczek_design/
NEXT_PUBLIC_LINKEDIN=
NEXT_PUBLIC_GITHUB=

# ─────────────────────────────────────────────────────────────
# VARIABLES PRIVADAS (solo servidor, NUNCA se exponen al cliente)
# ─────────────────────────────────────────────────────────────

# Clave de Resend (obtener en https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Correo donde RECIBEN los mensajes del formulario.
RESEND_EMAIL_DESTINO=contacto@nodoetico.com

# Remitente del correo. Debe ser un dominio VERIFICADO en Resend.
# Ejemplo: NODO ÉTICO <contacto@nodoetico.com>
RESEND_EMAIL_REMITENTE=NODO ÉTICO <contacto@nodoetico.com>